{
  "name": "elixi",
  "version": "1.0.0",
  "description": "ELIXI – Advanced Personal AI System Assistant",
  "private": true,
  "workspaces": [
    "desktop",
    "backend"
  ],
  "scripts": {
    "predev": "node scripts/cleanup-dev-ports.cjs",
    "predev:web": "node scripts/cleanup-dev-ports.cjs",
    "dev": "npm run dev:web",
    "dev:all": "npm run dev",
    "dev:core": "concurrently \"npm run dev:ai\" \"npm run dev:voice\" \"npm run dev:backend\" \"npm run dev:ui\" \"npm run dev:electron\"",
    "dev:web": "concurrently \"npm run dev:ai\" \"npm run dev:voice\" \"npm run dev:backend\" \"npm run dev:ui\" \"npm run dev:electron\"",
    "dev:all-with-voice": "concurrently \"npm run dev:ai\" \"npm run dev:voice\" \"npm run dev:backend\" \"npm run dev:ui\" \"npm run dev:electron\"",
    "dev:ai": "npm run start:ai",
    "dev:voice": "npm run start:voice",
    "dev:backend": "npm run dev --workspace=backend",
    "dev:ui": "npm run dev:ui --workspace=desktop",
    "dev:desktop": "concurrently \"npm run dev:ui\" \"npm run dev:electron\"",
    "dev:electron": "wait-on http://127.0.0.1:5173 && electron desktop/electron/main.js",
    "build": "npm run build --workspace=desktop && npm run build --workspace=backend",
    "check:startup": "node scripts/startup-health-check.mjs",
    "test:phase12": "powershell -ExecutionPolicy Bypass -File ./scripts/phase12-regression.ps1",
    "test:phase7": "powershell -ExecutionPolicy Bypass -File ./scripts/phase7-regression.ps1",
    "test:db": "cd backend && npx ts-node ../scripts/test-db-connections.ts",
    "start:ai": "cd ai-engine && ..\\.venv\\Scripts\\python.exe -m uvicorn main:app --host 0.0.0.0 --port 8000 --reload",
    "start:voice": "cd voice-engine && ..\\.venv\\Scripts\\python.exe -m uvicorn voice_server:app --host 0.0.0.0 --port 8001"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3",
    "kill-port": "^2.0.1",
    "typescript": "^5.4.5",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.elixi.app",
    "productName": "ELIXI",
    "directories": {
      "output": "dist"
    },
    "files": [
      "desktop/electron/**/*",
      "desktop/react-ui/dist/**/*",
      "backend/dist/**/*",
      "config/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "desktop/react-ui/public/assets/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "desktop/react-ui/public/assets/icon.icns"
    },
    "linux": {
      "target": "AppImage",
      "icon": "desktop/react-ui/public/assets/icon.png"
    }
  }
}
