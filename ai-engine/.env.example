# Cloud providers for ai-engine (optional)
GEMINI_API_KEY=your_gemini_key_here
GEMINI_MODEL=gemini-2.0-flash

OPENROUTER_API_KEY=your_openrouter_key_here
OPENROUTER_MODEL=meta-llama/llama-3-8b-instruct
OPENROUTER_SITE_URL=http://localhost
OPENROUTER_APP_NAME=Elixi AI Engine

# Backward compatibility alias (optional)
# ELIXI_ONLINE_API_KEY=
# ELIXI_ONLINE_MODEL=meta-llama/llama-3-8b-instruct

# Keep real keys in ai-engine/.env.local (ignored by git)

# Required security/auth configuration
JWT_SECRET_KEY=change_me_to_a_long_random_secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
AUTH_USERNAME=elixi_admin
AUTH_PASSWORD=change_me_to_a_strong_password

# Strict CORS origin allowlist (comma-separated)
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Rate limiting
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60

# Memory retention controls
MEMORY_MAX_FACTS_PER_USER=2000
MEMORY_TTL_DAYS=30
