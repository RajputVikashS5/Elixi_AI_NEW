{
  "name": "elixi-desktop",
  "version": "1.0.0",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:ui\" \"npm run dev:electron\"",
    "dev:ui": "vite --host 127.0.0.1 --config react-ui/vite.config.ts",
    "dev:electron": "wait-on http://127.0.0.1:5173 && tsc -p tsconfig.json && electron .",
    "build": "npm run build:ui && npm run build:electron",
    "build:ui": "vite build --config react-ui/vite.config.ts",
    "build:electron": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "active-win": "^8.2.1",
    "axios": "^1.6.8",
    "autoprefixer": "^10.4.19",
    "clsx": "^2.1.1",
    "electron-updater": "^6.1.8",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.3",
    "framer-motion": "^11.1.7",
    "lucide-react": "^0.378.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "react-router-dom": "^6.23.0",
    "react-syntax-highlighter": "^15.5.0",
    "recharts": "^2.12.7",
    "remark-gfm": "^4.0.0",
    "socket.io-client": "^4.7.5",
    "tailwind-merge": "^2.3.0",
    "uuid": "^11.0.5",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "@types/node": "^20.12.7",
    "concurrently": "^8.2.2",
    "electron": "^30.0.0",
    "typescript": "^5.4.5",
    "vite": "^5.2.10",
    "wait-on": "^7.2.0"
  }
}
